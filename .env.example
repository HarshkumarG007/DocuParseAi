# Application Host & Port Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Database Paths
STORAGE_DIR=./storage
DATABASE_PATH=./storage/db/docuparse.db
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# System Binaries Paths
# Provide absolute path on Windows, e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
POPPLER_PATH=

# ML Model Configuration
MODEL_NAME_OR_PATH=microsoft/layoutlmv3-base
FINE_TUNED_CHECKPOINT=./storage/models/layoutlmv3_finetuned
DEVICE=cuda
MAX_IMAGE_DIM=1024
INFERENCE_BATCH_SIZE=1

# Optional Security / Auth
API_KEY_AUTH_ENABLED=false
DOCUPARSE_API_KEY=
